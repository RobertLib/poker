    "rules.intro": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý hráč dostane dvě vlastní karty. Pět společných karet se otočí ve třech fázích — flop (3), turn (1) a river (1). Sestav nejlepší pětikaretní kombinaci z libovolného spojení svých dvou karet a stolu.\n\nSází se před flopem a po každé další fázi. Až sázení skončí, pot bere nejlepší kombinace — nebo poslední hráč ve hře, když všichni ostatní složí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each player gets two private cards. Five community cards are dealt face up in three stages — the flop (3), the turn (1) and the river (1). Make the best five-card hand using any combination of your two cards and the board.\n\nBetting happens before the flop and after each stage. When betting ends, the best hand at showdown wins the pot — or the last player standing takes it if everyone else folds."
          }
        }
      }
    },
    "rules.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "TEXAS HOLD'EM ZA 60 SEKUND"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TEXAS HOLD'EM IN 60 SECONDS"
          }
        }
      }
    },
    "rules.move.allIn": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošleš doprostřed celý svůj stack. Risk je zisk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push your whole stack into the middle. No guts, no glory."
          }
        }
      }
    },
